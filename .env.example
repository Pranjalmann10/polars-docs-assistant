# --- LangSmith tracing (Stage 8) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=polars-docs-assistant

# --- Agent brain model (Stage 6) ---
# Default: local Ollama model, no API key needed.
# llama3.1:8b, not qwen2.5-coder:7b -- the coder build's Ollama template
# unreliably omits the <tool_call> tags Ollama needs to parse a tool call out
# of the model's raw text, so tool_calls comes back empty. See src/agent/graph.py.
AGENT_MODEL_PROVIDER=ollama
AGENT_MODEL_NAME=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# --- Optional: swap in a hosted model instead ---
# ANTHROPIC_API_KEY=
# AGENT_MODEL_PROVIDER=anthropic
# AGENT_MODEL_NAME=claude-haiku-4-5

# --- Generator (Stage 7) ---
BASE_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct
ADAPTER_PATH=

# --- Index (Stage 3) ---
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=polars_docs
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
